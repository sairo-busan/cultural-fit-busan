# === 앱 서버 (전 환경 · Secret) ===

# 한국관광공사 TourAPI 4.0 서비스키 (공공데이터포털에서 발급)
TOUR_API_KEY=

# 기상청 단기예보 조회서비스 서비스키 (공공데이터포털에서 발급)
KMA_API_KEY=

# MongoDB Atlas 연결 문자열 (M0 무료 클러스터)
MONGODB_URI=


# === 링크 저장 실험 (lab/link-save) ===

# 실험 API · 화면 스위치. true 일 때만 열린다. Vercel 은 Preview · Development 만 (Config)
LINK_LAB_ENABLED=

# YouTube Data API v3 키 (Google Cloud 에서 발급, 서버 전용 · Secret)
YOUTUBE_API_KEY=

# 카카오 REST API 키 (Kakao Developers 에서 발급, 서버 전용 · Secret)
KAKAO_REST_API_KEY=

# 카카오 JavaScript 키 (브라우저에 노출, 카카오 콘솔 도메인 제한 필수 · Config)
NEXT_PUBLIC_KAKAO_JS_KEY=


# === 데이터 스크립트 (앱 실행에는 쓰지 않음) ===

# Vercel Blob 읽기 · 쓰기 토큰 (사진 · 오디오 업로드, Secret)
BLOB_READ_WRITE_TOKEN=