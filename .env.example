# 한국관광공사 TourAPI 4.0 서비스키 (공공데이터포털에서 발급)
TOUR_API_KEY=

# MongoDB Atlas 연결 문자열 (M0 무료 클러스터)
MONGODB_URI=

# 기상청 단기예보 조회서비스 서비스키 (공공데이터포털에서 발급)
KMA_API_KEY=

# --- 문서·디자인 접근용 (앱 런타임에는 쓰지 않음) ---

# Notion 내부 통합 토큰 (ntn_...) — 페이지별로 통합 연결 필요
NOTION_ACCESS_TOKEN=

# Figma 파일 URL (파일 키 추출용) — 같은 파일의 페이지 2개
# Page 2_최종이 최신 확정본, Page 1은 디자인시스템·스토어 에셋 참조용
FIGMA_PAGE_1_URL=
FIGMA_PAGE_2_URL=
